# WatchTower configuration for docker compose. Copy to .env (the setup
# scripts do this and generate the secrets). Never commit .env.

# --- Generated by scripts/setup.* -----------------------------------------
DB_ROOT_PASSWORD=
DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=

# --- Telegram (required): create two bots with @BotFather ------------------
TELEGRAM_ASSET_BOT_TOKEN=
TELEGRAM_SENTINEL_BOT_TOKEN=
# Bot usernames without "@", shown on the Telegram Setup page.
VITE_ASSET_BOT_USERNAME=
VITE_SENTINEL_BOT_USERNAME=
TELEGRAM_MODE=polling

# --- Optional API keys -----------------------------------------------------
# Free key from https://twelvedata.com — without it, stock alerts do not work.
TWELVE_DATA_API_KEY=
# Optional free CoinGecko Demo key (100 calls/min, 10,000 calls/month).
COINGECKO_API_KEY=
# Raises GitHub API limits for sentinel (10 -> 30 req/min).
GITHUB_TOKEN=

# --- App -------------------------------------------------------------------
APP_ENV=production
# IANA timezone for timestamps in Telegram messages, e.g. Asia/Jakarta,
# Asia/Makassar, Asia/Jayapura, Europe/Berlin. Empty means Asia/Jakarta.
APP_TIMEZONE=Asia/Jakarta
# Port of the web app on this machine (bound to 127.0.0.1 only).
WT_PORT=8080
FRONTEND_URL=http://localhost:8080
COOKIE_SECURE=false
# IPs/CIDRs allowed to set X-Forwarded-For for the API's per-IP rate limits.
# docker-compose.yml already trusts its private network (nginx); leave empty
# when running the API directly with `go run`.
TRUSTED_PROXIES=
DB_NAME=watchtower
DB_USER=watchtower

# --- Schedule and limits ---------------------------------------------------
ASSET_SCHEDULER_INTERVAL_HOURS=4
SENTINEL_SCHEDULER_INTERVAL_HOURS=6
JWT_EXPIRY_HOURS=24
MAX_UNIQUE_SYMBOLS=100
ALERT_COOLDOWN_HOURS=4
ALERT_PRICE_MOVE_PCT=3
# Daily Twelve Data credits that manual "Check now" runs may spend (the free
# tier has 800/day for everything). 0 disables manual stock refreshes.
TWELVE_DATA_MANUAL_DAILY_CREDITS=400

# --- Development only (make dev-up) ----------------------------------------
# Change if another MySQL/Redis already uses the port on this machine.
DB_HOST_PORT=3306
REDIS_HOST_PORT=6379
